<mvc:View
    controllerName="sales.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="view1Page"
        title="Sales &amp; Inventory Management"
        enableScrolling="true">

        <content>

            <IconTabBar
                id="mainTabBar"
                expandable="false"
                selectedKey="products"
                class="sapUiResponsiveContentPadding">

                <items>

                    <!-- ================================================= -->
                    <!-- PRODUCTS -->
                    <!-- ================================================= -->

                    <IconTabFilter
                        id="productsTab"
                        key="products"
                        text="Products"
                        icon="sap-icon://product">

                        <VBox class="sapUiSmallMargin">

                            <Toolbar>

                                <Title
                                    text="Products"
                                    level="H2"/>

                                <ToolbarSpacer/>

                                <Button
                                    text="Activate"
                                    icon="sap-icon://accept"
                                    type="Accept"
                                    press=".onActivateProduct"/>

                                <Button
                                    text="Deactivate"
                                    icon="sap-icon://decline"
                                    type="Reject"
                                    press=".onDeactivateProduct"
                                    class="sapUiTinyMarginBegin"/>

                                <Button
                                    text="Stock"
                                    icon="sap-icon://inventory"
                                    press=".onGetStock"
                                    class="sapUiTinyMarginBegin"/>

                                <Button
                                    text="Refresh"
                                    icon="sap-icon://refresh"
                                    press=".onRefresh"
                                    class="sapUiTinyMarginBegin"/>

                            </Toolbar>


                            <Title
                                text="Product List"
                                level="H3"
                                class="sapUiSmallMarginTop"/>


                            <Table
                                id="productsTable"
                                mode="SingleSelectLeft"
                                growing="true"
                                growingThreshold="20"
                                noDataText="No products available"
                                items="{local>/products}"
                                selectionChange=".onProductSelectionChange">

                                <columns>

                                    <Column>
                                        <Text text="Product Code"/>
                                    </Column>

                                    <Column>
                                        <Text text="Product Name"/>
                                    </Column>

                                    <Column>
                                        <Text text="Category ID"/>
                                    </Column>

                                    <Column hAlign="End">
                                        <Text text="Unit Price"/>
                                    </Column>

                                    <Column hAlign="End">
                                        <Text text="Stock Qty"/>
                                    </Column>

                                    <Column>
                                        <Text text="Status"/>
                                    </Column>

                                </columns>

                                <items>

                                    <ColumnListItem>

                                        <cells>

                                            <Text
                                                text="{local>productCode}"/>

                                            <Text
                                                text="{local>productName}"/>

                                            <Text
                                                text="{local>category_ID}"/>

                                            <ObjectNumber
                                                number="{local>unitPrice}"
                                                unit="INR"/>

                                            <ObjectNumber
                                                number="{local>stockQty}"/>

                                            <ObjectStatus
                                                text="{local>status}"
                                                state="None"/>

                                        </cells>

                                    </ColumnListItem>

                                </items>

                            </Table>

                        </VBox>

                    </IconTabFilter>


                    <!-- ================================================= -->
                    <!-- SALES -->
                    <!-- ================================================= -->

                    <IconTabFilter
                        id="salesTab"
                        key="sales"
                        text="Sales"
                        icon="sap-icon://sales-order">

                        <VBox class="sapUiSmallMargin">

                            <Toolbar>

                                <Title
                                    text="Sales"
                                    level="H2"/>

                                <ToolbarSpacer/>

                                <Button
                                    text="New Sale"
                                    icon="sap-icon://add"
                                    type="Emphasized"
                                    press=".onNewSale"/>

                                <Button
                                    text="Complete"
                                    icon="sap-icon://accept"
                                    type="Accept"
                                    press=".onCompleteSale"
                                    class="sapUiTinyMarginBegin"/>

                                <Button
                                    text="Cancel"
                                    icon="sap-icon://decline"
                                    type="Reject"
                                    press=".onCancelSale"
                                    class="sapUiTinyMarginBegin"/>

                                <Button
                                    text="Refresh"
                                    icon="sap-icon://refresh"
                                    press=".onRefresh"
                                    class="sapUiTinyMarginBegin"/>

                            </Toolbar>


                            <Title
                                text="Sales List"
                                level="H3"
                                class="sapUiSmallMarginTop"/>


                            <Table
                                id="salesTable"
                                mode="SingleSelectLeft"
                                growing="true"
                                growingThreshold="20"
                                noDataText="No sales available"
                                items="{local>/sales}"
                                selectionChange=".onSaleSelectionChange">

                                <columns>

                                    <Column>
                                        <Text text="Sale Number"/>
                                    </Column>

                                    <Column>
                                        <Text text="Customer ID"/>
                                    </Column>

                                    <Column>
                                        <Text text="Product ID"/>
                                    </Column>

                                    <Column hAlign="End">
                                        <Text text="Quantity"/>
                                    </Column>

                                    <Column hAlign="End">
                                        <Text text="Unit Price"/>
                                    </Column>

                                    <Column hAlign="End">
                                        <Text text="Total Amount"/>
                                    </Column>

                                    <Column>
                                        <Text text="Sale Date"/>
                                    </Column>

                                    <Column>
                                        <Text text="Status"/>
                                    </Column>

                                </columns>


                                <items>

                                    <ColumnListItem>

                                        <cells>

                                            <Text
                                                text="{local>saleNumber}"/>

                                            <Text
                                                text="{local>customer_ID}"/>

                                            <Text
                                                text="{local>product_ID}"/>

                                            <ObjectNumber
                                                number="{local>quantity}"/>

                                            <ObjectNumber
                                                number="{local>unitPrice}"
                                                unit="INR"/>

                                            <ObjectNumber
                                                number="{local>totalAmount}"
                                                unit="INR"/>

                                            <Text
                                                text="{local>saleDate}"/>

                                            <ObjectStatus
                                                text="{local>status}"
                                                state="None"/>

                                        </cells>

                                    </ColumnListItem>

                                </items>

                            </Table>

                        </VBox>

                    </IconTabFilter>

                </items>

            </IconTabBar>

        </content>

    </Page>

</mvc:View>